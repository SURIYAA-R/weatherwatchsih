# ─────────────────────────────────────────────────────────────
# WeatherWatch Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git (it's in .gitignore)
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# For LOCAL development (SQLite — no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./weatherwatch.db

# For PRODUCTION (Supabase PostgreSQL):
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection string → URI
# Change "postgresql://" to "postgresql+asyncpg://" for async support
# DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Map API ───────────────────────────────────────────────────
# Get from: https://account.mapbox.com/ → Tokens → Create a token
MAPBOX_TOKEN=pk.REPLACE_WITH_YOUR_MAPBOX_TOKEN

# ── App Settings ──────────────────────────────────────────────
APP_ENV=development          # development | production
CORS_ORIGINS=*               # restrict in production e.g. https://yourapp.render.com
